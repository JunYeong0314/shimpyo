    <!-- Voice lines (TextToSpeech) -->
    <string name="tts_checkin">You have been driving for %1$s. On a scale of one to nine, how sleepy do you feel?</string>
    <string name="tts_checkin_retry">Sorry, I didn\'t catch that. Please say a number from one to nine.</string>
    <string name="tts_checkin_ok">Good. I\'ll check in again in %1$d minutes.</string>
    <string name="tts_propose_long_drive">You have been driving for almost two hours.</string>
    <string name="tts_propose">%1$s is %2$s ahead. Shall we take a break there?</string>
    <string name="tts_propose_cafe">It has a café, good for a coffee nap.</string>
    <string name="tts_waypoint_added">Added %1$s as a stop.</string>
    <string name="tts_waypoint_failed">I couldn\'t add the stop. Please pull into the next rest area.</string>
    <string name="tts_snooze">Okay. I\'ll ask again in %1$d minutes.</string>
    <string name="tts_no_rest_area">I couldn\'t find a rest stop nearby. Please take a break somewhere safe.</string>
    <string name="tts_user_request">Let me find a rest stop nearby.</string>
    <string name="tts_arrived">You have arrived. Park the car and I\'ll get your break ready.</string>
    <string name="tts_choose_mode">Would you like a %1$d-minute car nap, a coffee nap, or a five-minute stretch?</string>
    <string name="tts_nap_intro">Let\'s begin. Recline your seat and get comfortable.</string>
    <string name="tts_family_mode">Since others are on board, I\'ll dim only the driver\'s side.</string>
    <string name="tts_coffee_intro">Close your eyes right after your coffee. Caffeine kicks in in about twenty minutes.</string>
    <string name="tts_breath_in">Breathe in slowly.</string>
    <string name="tts_breath_out">And breathe out.</string>
    <string name="tts_stretch_1">Slowly tilt your head to the left, then to the right.</string>
    <string name="tts_stretch_2">Lift your shoulders toward your ears, then let them drop.</string>
    <string name="tts_stretch_3">Lace your fingers and push your arms forward.</string>
    <string name="tts_stretch_4">If it is safe, step out and take a short walk.</string>
    <string name="tts_stretch_done">Nice work. Ready when you are.</string>
    <string name="tts_wake_greeting">Welcome back. Let\'s do a quick check.</string>
    <string name="tts_reverse_digits">Say these numbers in reverse order. %1$s.</string>
